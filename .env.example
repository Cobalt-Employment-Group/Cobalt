# Contact form delivery
#
# Copy this file to .env.local and fill in values from your form-relay
# provider. The recipient email is configured at the provider, not here,
# so it never appears in the client bundle or HTML.
#
# Recommended providers (free tiers available):
#   - Web3Forms     https://web3forms.com   (set VITE_FORM_KEY to your access key)
#   - Formspree     https://formspree.io     (use the form's POST URL only)
#   - Getform       https://getform.io
#
# Example for Web3Forms:
#   VITE_FORM_ENDPOINT=https://api.web3forms.com/submit
#   VITE_FORM_KEY=00000000-0000-0000-0000-000000000000
#
# Example for Formspree (no key needed):
#   VITE_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx
#   VITE_FORM_KEY=

VITE_FORM_ENDPOINT=
VITE_FORM_KEY=
