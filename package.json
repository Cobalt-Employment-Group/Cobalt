{
  "name": "cobalt-employment-group",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && node scripts/build.mjs",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit && tsc --project tsconfig.tests.json --noEmit",
    "test": "npm run build && node scripts/build.mjs --test-form && node scripts/build.mjs --test-empty && playwright test",
    "test:browser": "playwright test",
    "check:output": "node scripts/check-output.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/source-serif-4": "5.3.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1"
  },
  "engines": {
    "node": ">= 20.20.0",
    "npm": ">= 10.8.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "~9.39.2",
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.0",
    "@types/react": "~18.3.27",
    "@types/react-dom": "~18.3.7",
    "@typescript-eslint/eslint-plugin": "~8.53.0",
    "@typescript-eslint/parser": "~8.53.0",
    "@vitejs/plugin-react": "~5.1.2",
    "esbuild": "0.28.2",
    "eslint": "~9.39.2",
    "eslint-plugin-react-hooks": "~7.0.1",
    "eslint-plugin-react-refresh": "~0.4.26",
    "globals": "~17.0.0",
    "typescript": "~5.9.3",
    "vite": "~7.3.1"
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
